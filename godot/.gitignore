.godot/
*.import
# Godot extracts the textures embedded in each GLB; they are rebuilt on import.
assets/**/*.png
assets/**/*.png.import
build/
!assets/world/valley_cover.png
!assets/world/valley_path.png
!assets/world/lake_mask.png
# tablet UI kit art is generated source-of-truth for the game; keep it tracked
!assets/ui/tablet/**/*.png
# phone app art (lane appui2) is generated source-of-truth too
!assets/ui/*.png
!assets/ui/icons/**/*.png
!assets/ui/sizes/**/*.png
!assets/ui/avatars/**/*.png
!assets/ui/items/**/*.png
!assets/ui/thumbs/**/*.png
# tablet OS / HUD / map art (lane osui) is generated source-of-truth too
!assets/ui/osui/**/*.png
